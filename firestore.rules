rules_version = '2';

// Paste this whole file into Firebase Console → Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard: everyone can read; a player can only write their own row.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 32
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 1000000000000000000;
    }

    // Promo codes: added by you in the console. Players can check one code by name,
    // but cannot list all codes or change them.
    match /codes/{code} {
      allow get: if true;
      allow list, write: if false;
    }

    // Episode votes: { a: number, b: number }. Each write may add exactly one vote.
    match /votes/{episode} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'b'])
        && request.resource.data.a + request.resource.data.b == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['a', 'b'])
        && request.resource.data.a >= resource.data.a
        && request.resource.data.b >= resource.data.b
        && request.resource.data.a + request.resource.data.b == resource.data.a + resource.data.b + 1;
    }

    // Daily stats: stats/{YYYY-MM-DD} -> { players, newPlayers }.
    // Players can only add +1; nobody can read it from the game (you see it in the console).
    match /stats/{day} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['players', 'newPlayers'])
        && request.resource.data.players == 1
        && request.resource.data.get('newPlayers', 1) == 1;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['players', 'newPlayers'])
        && request.resource.data.players == resource.data.players + 1
        && (request.resource.data.get('newPlayers', 0) == resource.data.get('newPlayers', 0)
            || request.resource.data.get('newPlayers', 0) == resource.data.get('newPlayers', 0) + 1);
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
